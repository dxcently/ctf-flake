# Copy to .env and fill with strong random values. NEVER commit the real .env.
# Generate values with:  ./gen-secrets.sh   (writes a ready-to-use .env)
CTFD_SECRET_KEY=replace_me_64_random_bytes
MYSQL_ROOT_PASSWORD=replace_me_strong
MYSQL_PASSWORD=replace_me_strong

# Per-challenge flags (injected at build time; keeps flags out of git).
# BOTH are required — docker-compose passes them as build-args and an empty
# value will silently produce an empty flag file inside the image.
PWN_FLAG=CTF{sm4sh_the_stack_f0r_fun_and_pr0fit}
WEB_FLAG=CTF{p4th_tr4versal_unl0cks_the_v4ult}
